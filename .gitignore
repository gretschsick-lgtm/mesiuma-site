# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# X session files (ローカルのプロファイルは除外、暗号化済みは CI でのみコミット)
scripts/.x_auth_profile/
scripts/.x_session

# NS-9 store X discovery: 探索状態は Actions cache で持続（git 管理しない＝不要な commit を出さない）
scripts/.discover_state.json
public/store_x_candidates.json

# NS-P1 free performer discovery: 状態は Actions cache / レポートは artifact（git 管理しない）
scripts/.performer_state.json
public/free_performer_candidates.json
